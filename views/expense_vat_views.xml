<odoo>

    <!-- Wizard: what the VAT of a posted expense becomes. -->
    <record id="expense_scan_vat_wizard_view_form" model="ir.ui.view">
        <field name="name">expense.scan.vat.wizard.form</field>
        <field name="model">expense.scan.vat.wizard</field>
        <field name="arch" type="xml">
            <form string="Correct VAT">
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="expense_count" invisible="1"/>
                <field name="needs_confirmation" invisible="1"/>
                <field name="lock_notice" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="not needs_confirmation">
                    <field name="cycle_warning" nolabel="1" readonly="1"/>
                </div>
                <group>
                    <group>
                        <field name="expense_ids" widget="many2many_tags" readonly="1"/>
                        <field name="current_vat"/>
                        <field name="mode" widget="radio" invisible="expense_count &gt; 1"/>
                        <field name="batch_mode" widget="radio" string="Correction"
                               invisible="expense_count &lt; 2"/>
                        <field name="tax_id" options="{'no_create': True}"
                               invisible="mode != 'recoverable' or expense_count != 1"
                               required="mode == 'recoverable' and expense_count == 1"/>
                        <field name="amount"
                               invisible="mode != 'amount' or expense_count != 1"/>
                        <field name="new_vat" invisible="expense_count != 1"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="journal_id" options="{'no_create': True}" required="1"/>
                    </group>
                </group>
                <!-- Odoo dates an entry made in a locked period on the first open day. -->
                <div class="alert alert-info" role="alert" invisible="not lock_notice">
                    <field name="lock_notice" nolabel="1" readonly="1"/>
                </div>
                <group invisible="not needs_confirmation">
                    <field name="confirmed"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Correct"
                            class="btn-primary" data-hotkey="q"
                            invisible="needs_confirmation and not confirmed"/>
                    <button special="cancel" string="Cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Expense form: the button, the corrections and the VAT the accounting recovers. -->
    <record id="hr_expense_view_form_vat" model="ir.ui.view">
        <field name="name">hr.expense.view.form.vat</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_expense_scan_correct_vat" string="Correct VAT" type="object"
                        invisible="state not in ('posted', 'in_payment', 'paid')"
                        groups="account.group_account_manager"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_expense_scan_open_vat_moves" type="object"
                        class="oe_stat_button" icon="balance"
                        invisible="not expense_scan_vat_move_count"
                        groups="account.group_account_invoice">
                    <field name="expense_scan_vat_move_count" widget="statinfo" string="VAT corrections"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='expense_scan_invoice_id']" position="after">
                <field name="expense_scan_vat_changed" invisible="1"/>
                <field name="expense_scan_recoverable_vat" readonly="1"
                       invisible="not expense_scan_vat_changed"
                       groups="hr_expense.group_hr_expense_user,account.group_account_invoice"/>
            </xpath>
        </field>
    </record>

    <!-- Journal entry of a correction: the expense it belongs to. -->
    <record id="view_move_form_expense_vat" model="ir.ui.view">
        <field name="name">account.move.form.expense.vat</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_cash_basis_origin_move_id']" position="after">
                <field name="expense_scan_vat_expense_id" invisible="not expense_scan_vat_expense_id"
                       groups="hr_expense.group_hr_expense_user"/>
            </xpath>
        </field>
    </record>

    <!-- Same from the lists: select the expenses, then Actions. -->
    <record id="action_expense_scan_correct_vat" model="ir.actions.server">
        <field name="name">Correct VAT</field>
        <field name="model_id" ref="hr_expense.model_hr_expense"/>
        <field name="binding_model_id" ref="hr_expense.model_hr_expense"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_expense_scan_correct_vat()</field>
    </record>

</odoo>

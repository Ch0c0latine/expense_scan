<odoo>

    <record id="expense_scan_policy_view_list" model="ir.ui.view">
        <field name="name">expense.scan.policy.list</field>
        <field name="model">expense.scan.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="apply_to_all"/>
                <field name="partner_ids" widget="many2many_tags"/>
                <field name="project_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="expense_scan_policy_view_search" model="ir.ui.view">
        <field name="name">expense.scan.policy.search</field>
        <field name="model">expense.scan.policy</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_ids"/>
                <field name="project_ids"/>
                <filter string="Toutes les dépenses" name="apply_to_all"
                        domain="[('apply_to_all', '=', True)]"/>
                <separator/>
                <filter string="Archivées" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="expense_scan_policy_view_form" model="ir.ui.view">
        <field name="name">expense.scan.policy.form</field>
        <field name="model">expense.scan.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Bonnes pratiques de l'entreprise"/></h1>
                    </div>
                    <group>
                        <group string="Dépenses contrôlées">
                            <field name="apply_to_all"/>
                            <field name="partner_ids" widget="many2many_tags"
                                   invisible="apply_to_all" options="{'no_create': True}"/>
                            <field name="project_ids" widget="many2many_tags"
                                   invisible="apply_to_all" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="text-muted mb-2">
                        Une règle alerte sans bloquer : ⚠ pour un dépassement,
                        ? pour un point à vérifier. Sans famille ni catégorie,
                        elle vise toutes les dépenses.
                    </div>
                    <field name="rule_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="family" placeholder="toutes"/>
                            <field name="product_ids" widget="many2many_tags" optional="hide"/>
                            <field name="rule_type"/>
                            <field name="meal_period"
                                   invisible="rule_type not in ('max_amount', 'daily_max')"/>
                            <field name="amount"
                                   invisible="rule_type not in ('max_amount', 'daily_max')"/>
                            <field name="per_night" invisible="rule_type != 'max_amount'"/>
                            <field name="extra_amount" invisible="rule_type != 'max_amount'"/>
                            <field name="extra_cities" invisible="rule_type != 'max_amount'"
                                   placeholder="Paris, Lyon, Marseille"/>
                            <field name="words" invisible="rule_type != 'forbidden_words'"
                                   placeholder="Un mot par ligne"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Source des règles, date de mise à jour…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="expense_scan_policy_action" model="ir.actions.act_window">
        <field name="name">Règles de dépenses</field>
        <field name="res_model">expense.scan.policy</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="expense_scan_policy_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Définissez vos règles de dépenses</p>
            <p>Plafonds de repas et d'hôtel, dépenses à écarter, exigences d'un
               client : chaque dépense concernée affiche une alerte, et le
               filtre « Hors règles » les rassemble. Archivez un ensemble pour
               le suspendre.</p>
        </field>
    </record>

    <menuitem id="menu_expense_scan_policies"
              name="Règles de dépenses"
              parent="hr_expense.menu_hr_expense_configuration"
              action="expense_scan_policy_action"
              groups="hr_expense.group_hr_expense_manager"
              sequence="31"/>

    <!-- Filtres rapides : frais à refacturer, et frais hors règles. -->
    <record id="hr_expense_view_search_scan" model="ir.ui.view">
        <field name="name">hr.expense.view.search.scan</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="project_id"/>
            </xpath>
            <xpath expr="//filter[@name='to_pay']" position="after">
                <separator/>
                <filter string="À refacturer" name="to_reinvoice"
                        domain="[('reinvoice_mode', '=', 'project')]"/>
                <filter string="Refacturation à déterminer" name="reinvoice_todo"
                        domain="[('reinvoice_mode', '=', 'todo')]"/>
                <filter string="Hors règles" name="policy_breach"
                        domain="[('expense_scan_policy_breach', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!-- Alerte en tête de la dépense. -->
    <record id="hr_expense_view_form_policy" model="ir.ui.view">
        <field name="name">hr.expense.view.form.policy</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='warning_duplicate_receipt_expense']" position="before">
                <div class="alert alert-warning mb-2" role="alert"
                     invisible="not expense_scan_policy_alert">
                    <strong>Règles de dépenses</strong>
                    <field name="expense_scan_policy_alert" readonly="1" nolabel="1"
                           class="d-block" style="white-space: pre-line;"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>

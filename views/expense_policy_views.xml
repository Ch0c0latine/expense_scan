<odoo>

    <record id="expense_scan_policy_view_list" model="ir.ui.view">
        <field name="name">expense.scan.policy.list</field>
        <field name="model">expense.scan.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="apply_to_all"/>
                <field name="partner_ids" widget="many2many_tags"/>
                <field name="project_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="expense_scan_policy_view_search" model="ir.ui.view">
        <field name="name">expense.scan.policy.search</field>
        <field name="model">expense.scan.policy</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_ids"/>
                <field name="project_ids"/>
                <filter string="All expenses" name="apply_to_all"
                        domain="[('apply_to_all', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="expense_scan_policy_view_form" model="ir.ui.view">
        <field name="name">expense.scan.policy.form</field>
        <field name="model">expense.scan.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Company good practice"/></h1>
                    </div>
                    <group>
                        <group string="Expenses checked">
                            <field name="apply_to_all"/>
                            <field name="partner_ids" widget="many2many_tags"
                                   invisible="apply_to_all" options="{'no_create': True}"/>
                            <field name="project_ids" widget="many2many_tags"
                                   invisible="apply_to_all" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="text-muted mb-2">
                        A rule warns without blocking: ⚠ when a limit is
                        exceeded, ℹ︎ for a point to check. "Done" puts out
                        the ℹ︎ signs, a justification the ⚠ signs. Without a
                        family or a category, it applies to every expense.
                    </div>
                    <field name="rule_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="family" placeholder="all"/>
                            <field name="product_ids" widget="many2many_tags" optional="hide"/>
                            <field name="rule_type"/>
                            <field name="meal_period"
                                   invisible="rule_type not in ('max_amount', 'daily_max')"/>
                            <field name="amount"
                                   invisible="rule_type not in ('max_amount', 'daily_max')"/>
                            <field name="per_night" invisible="rule_type != 'max_amount'"/>
                            <field name="extra_amount" invisible="rule_type != 'max_amount'"/>
                            <field name="extra_cities" invisible="rule_type != 'max_amount'"
                                   placeholder="Paris, Lyon, Marseille"/>
                            <field name="words" invisible="rule_type != 'forbidden_words'"
                                   placeholder="One word per line"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Where the rules come from, date of the last update..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="expense_scan_policy_action" model="ir.actions.act_window">
        <field name="name">Expense Rules</field>
        <field name="res_model">expense.scan.policy</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="expense_scan_policy_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your expense rules</p>
            <p>Meal and hotel ceilings, expenses to avoid, a customer's
               requirements: each expense concerned shows a warning, and the
               "Rule breaches" filter gathers them. Archive a set of rules to
               suspend it.</p>
        </field>
    </record>

    <menuitem id="menu_expense_scan_policies"
              name="Expense Rules"
              parent="hr_expense.menu_hr_expense_configuration"
              action="expense_scan_policy_action"
              groups="hr_expense.group_hr_expense_manager"
              sequence="31"/>

    <!-- Quick filters: expenses to re-invoice, and expenses breaking the rules. -->
    <record id="hr_expense_view_search_scan" model="ir.ui.view">
        <field name="name">hr.expense.view.search.scan</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="project_id"/>
            </xpath>
            <xpath expr="//filter[@name='to_pay']" position="after">
                <separator/>
                <filter string="To re-invoice" name="to_reinvoice"
                        domain="[('reinvoice_mode', '=', 'project')]"/>
                <filter string="Re-invoicing to be decided" name="reinvoice_todo"
                        domain="[('reinvoice_mode', '=', 'todo')]"/>
                <filter string="Rule breaches" name="policy_breach"
                        domain="[('expense_scan_policy_breach', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!-- Sign of the rule findings in the lists, to spot the exceptions at
         a glance. -->
    <record id="hr_expense_view_list_policy" model="ir.ui.view">
        <field name="name">hr.expense.list.policy</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_expenses_analysis_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="expense_scan_policy_status" nolabel="1" readonly="1"
                       optional="show" class="text-warning"/>
            </field>
        </field>
    </record>

    <record id="hr_expense_view_kanban_policy" model="ir.ui.view">
        <field name="name">hr.expense.kanban.policy</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_expenses_analysis_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//templates//field[@name='name']" position="before">
                <field name="expense_scan_policy_status" class="text-warning me-1"
                       invisible="not expense_scan_policy_status"/>
            </xpath>
        </field>
    </record>

    <!-- Warning at the top of the expense. -->
    <record id="hr_expense_view_form_policy" model="ir.ui.view">
        <field name="name">hr.expense.view.form.policy</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='warning_duplicate_receipt_expense']" position="before">
                <div class="alert alert-warning mb-2" role="alert"
                     invisible="not expense_scan_policy_alert">
                    <strong>Expense rules</strong>
                    <field name="expense_scan_policy_alert" readonly="1" nolabel="1"
                           class="d-block" style="white-space: pre-line;"/>
                    <!-- A justified breach no longer shows its sign in the
                         lists; the manager reads the reason here. -->
                    <div class="d-flex align-items-baseline gap-2 mt-2"
                         invisible="not expense_scan_policy_breach">
                        <label for="expense_scan_policy_justification" class="fw-bold text-nowrap"/>
                        <field name="expense_scan_policy_justification" class="flex-grow-1"
                               readonly="not is_editable"
                               placeholder="Why this expense goes beyond the rules"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>

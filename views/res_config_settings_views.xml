<odoo>

    <record id="res_config_settings_view_form_scan" model="ir.ui.view">
        <field name="name">res.config.settings.form.expense.scan</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="hr_expense.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='expenses_setting_container']" position="inside">

                <setting id="expense_scan_setting" string="Receipt scanning"
                         company_dependent="1"
                         help="Read photographed receipts on your own server, without credits or subscription">
                    <field name="expense_scan_enabled"/>
                    <div class="content-group" invisible="not expense_scan_enabled">
                        <div class="row mt16">
                            <label for="expense_scan_engine" class="col-lg-4 o_light_label"/>
                            <field name="expense_scan_engine"/>
                        </div>
                        <div class="row" invisible="expense_scan_engine == 'rapidocr'">
                            <label for="expense_scan_tesseract_lang" class="col-lg-4 o_light_label"/>
                            <field name="expense_scan_tesseract_lang"/>
                        </div>
                        <div class="row">
                            <label for="expense_scan_threads" class="col-lg-4 o_light_label"/>
                            <field name="expense_scan_threads"/>
                        </div>
                        <div class="row">
                            <label for="expense_scan_max_age_days" class="col-lg-4 o_light_label"/>
                            <field name="expense_scan_max_age_days"/>
                        </div>
                        <div class="row">
                            <label for="expense_scan_text_retention_days" class="col-lg-4 o_light_label"/>
                            <field name="expense_scan_text_retention_days"/>
                        </div>
                        <div class="row" invisible="expense_scan_engine == 'tesseract'">
                            <label for="expense_scan_model_dir" class="col-lg-4 o_light_label"/>
                            <field name="expense_scan_model_dir"
                                   placeholder="default: Odoo's data directory"/>
                        </div>
                        <div class="mt8">
                            <button name="action_expense_scan_self_test" type="object"
                                    string="Test and preload the engine"
                                    class="btn btn-link ps-0" icon="fa-play-circle"/>
                        </div>
                        <field name="expense_scan_status" widget="text" readonly="1"
                               class="text-muted small"/>
                    </div>
                </setting>

                <setting id="expense_scan_image_setting" string="Photo processing"
                         company_dependent="1"
                         invisible="not expense_scan_enabled"
                         help="Cut out and straighten the receipt before reading it">
                    <div class="content-group">
                        <div><field name="expense_scan_autocrop"/>
                            <label for="expense_scan_autocrop"/></div>
                        <div><field name="expense_scan_deskew"/>
                            <label for="expense_scan_deskew"/></div>
                        <div><field name="expense_scan_auto_rotate"/>
                            <label for="expense_scan_auto_rotate"/></div>
                        <div><field name="expense_scan_keep_original"/>
                            <label for="expense_scan_keep_original"/></div>
                        <div><field name="expense_scan_wide_split"/>
                            <label for="expense_scan_wide_split"/></div>
                    </div>
                </setting>

                <setting id="expense_scan_accounting_setting" string="Accounting fields"
                         company_dependent="1"
                         invisible="not expense_scan_enabled"
                         help="What the scan may fill in on its own">
                    <div class="content-group">
                        <div><field name="expense_scan_apply_tax"/>
                            <label for="expense_scan_apply_tax"/></div>
                        <div><field name="expense_scan_set_vendor"/>
                            <label for="expense_scan_set_vendor"/></div>
                        <div><field name="expense_scan_reinvoice"/>
                            <label for="expense_scan_reinvoice"/></div>
                        <div class="mt-2">
                            <label for="expense_scan_product_id" class="o_light_label"/>
                            <field name="expense_scan_product_id"
                                   options="{'no_create': True}"
                                   placeholder="default: Odoo's choice (reference EXP_GEN)"/>
                        </div>
                    </div>
                </setting>

                <setting id="expense_scan_sheet_setting" string="Expense sheets and rules"
                         help="Delivered examples: an Excel template to adapt, good practice rules to adjust or archive">
                    <div class="content-group">
                        <div>
                            <button name="%(expense_scan.expense_scan_export_template_action)d"
                                    type="action" string="Excel export templates"
                                    class="btn-link ps-0" icon="oi-arrow-right"/>
                        </div>
                        <div>
                            <button name="%(expense_scan.expense_scan_policy_action)d"
                                    type="action" string="Expense Rules"
                                    class="btn-link ps-0" icon="oi-arrow-right"/>
                        </div>
                        <div class="text-muted small mt-1">
                            The expense sheet is produced from the expense
                            list: select the expenses, then "Expense Sheet".
                        </div>
                    </div>
                </setting>

                <!-- Last: support is optional. -->
                <setting id="expense_scan_support_setting" string="Support Expense Scan"
                         help="Free module, developed in its author's own time">
                    <div class="content-group">
                        <a href="https://github.com/sponsors/Ch0c0latine" target="_blank"
                           rel="noopener noreferrer" class="btn btn-link ps-0" role="button">
                            <i class="fa fa-coffee me-1"/>Buy the author a coffee
                        </a>
                    </div>
                </setting>

            </xpath>
        </field>
    </record>

</odoo>

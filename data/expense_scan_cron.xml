<odoo>

    <!-- Pick up the pending scans if the app stopped. -->
    <record id="ir_cron_expense_scan_pending" model="ir.cron">
        <field name="name">Receipt scan: pick up pending scans</field>
        <field name="model_id" ref="hr_expense.model_hr_expense"/>
        <field name="state">code</field>
        <field name="code">model._cron_expense_scan_pending()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Erase the text read (personal data) after the configured delay. -->
    <record id="ir_cron_expense_scan_purge_texts" model="ir.cron">
        <field name="name">Receipt scan: erase the text read on old expenses</field>
        <field name="model_id" ref="hr_expense.model_hr_expense"/>
        <field name="state">code</field>
        <field name="code">model._cron_expense_scan_purge_texts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>

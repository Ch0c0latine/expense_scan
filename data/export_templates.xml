<odoo noupdate="1">

    <!-- Modèle de base : toutes les valeurs utiles, dans un classeur vierge
         fabriqué à l'installation. À télécharger, mettre aux couleurs de
         l'entreprise, puis redéposer — ou à dupliquer pour un client. -->
    <record id="export_template_basic" model="expense.scan.export.template">
        <field name="name">Fiche de frais (modèle de base)</field>
        <field name="sequence">1</field>
        <field name="first_row">8</field>
        <field name="last_row">9</field>
        <field name="note">Classeur livré avec le module : téléchargez-le depuis le champ « Fichier Excel », adaptez-le (logo, couleurs, colonnes), puis redéposez-le. Gardez une ligne de titres au-dessus des dépenses et les totaux juste en dessous : l'export ajoute ou retire des lignes et les totaux suivent. Le bouton « Classeur vierge » en refabrique un d'après les correspondances ci-dessous.</field>
    </record>

    <record id="export_template_basic_salarie" model="expense.scan.export.column">
        <field name="template_id" ref="export_template_basic"/>
        <field name="cell">B3</field>
        <field name="value">salarie</field>
    </record>
    <record id="export_template_basic_periode" model="expense.scan.export.column">
        <field name="template_id" ref="export_template_basic"/>
        <field name="cell">B4</field>
        <field name="value">periode</field>
    </record>
    <record id="export_template_basic_societe" model="expense.scan.export.column">

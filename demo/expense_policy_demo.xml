<odoo>

    <!-- Example: customer rules stricter than the general good practice. -->
    <record id="demo_client" model="res.partner">
        <field name="name">Example Industries Ltd</field>
        <field name="is_company" eval="True"/>
        <field name="city">Lyon</field>
    </record>
    <record id="demo_client_site" model="res.partner">
        <field name="name">Production site</field>
        <field name="parent_id" ref="demo_client"/>
        <field name="type">other</field>
    </record>
    <record id="demo_project" model="project.project">
        <field name="name">Demo project</field>
        <field name="partner_id" ref="demo_client_site"/>
    </record>
    <record id="demo_task_audit" model="project.task">
        <field name="name">On-site audit</field>
        <field name="project_id" ref="demo_project"/>
        <field name="sequence">1</field>
    </record>
    <record id="demo_task_report" model="project.task">
        <field name="name">Final report</field>
        <field name="project_id" ref="demo_project"/>
        <field name="sequence">2</field>
    </record>

    <record id="demo_policy" model="expense.scan.policy"
            context="{'expense_scan_no_recheck': True}">
        <field name="name">Example: a customer's requirements</field>
        <field name="partner_ids" eval="[(6, 0, [ref('demo_client')])]"/>
        <field name="note">Made-up rules, set by contract with the customer: they apply to the projects of its sites, on top of the company's good practice.</field>
    </record>

    <record id="demo_policy_travel_class" model="expense.scan.policy.rule"
            context="{'expense_scan_no_recheck': True}">
        <field name="policy_id" ref="demo_policy"/>
        <field name="sequence">1</field>
        <field name="name">Train in 2nd class, plane in economy class, no exception</field>
        <field name="family">train_air</field>
        <field name="rule_type">forbidden_words</field>
        <field name="words">1ère classe
première classe
first class
business
premium economy</field>
    </record>
    <record id="demo_policy_breakfast" model="expense.scan.policy.rule"
            context="{'expense_scan_no_recheck': True}">
        <field name="policy_id" ref="demo_policy"/>
        <field name="sequence">2</field>
        <field name="name">Breakfast: 15 at most</field>
        <field name="family">meal</field>
        <field name="meal_period">breakfast</field>
        <field name="amount">15</field>
    </record>
    <record id="demo_policy_lunch" model="expense.scan.policy.rule"
            context="{'expense_scan_no_recheck': True}">
        <field name="policy_id" ref="demo_policy"/>
        <field name="sequence">3</field>
        <field name="name">Lunch: 25 at most</field>
        <field name="family">meal</field>
        <field name="meal_period">lunch</field>
        <field name="amount">25</field>
    </record>
    <record id="demo_policy_dinner" model="expense.scan.policy.rule"
            context="{'expense_scan_no_recheck': True}">
        <field name="policy_id" ref="demo_policy"/>
        <field name="sequence">4</field>
        <field name="name">Dinner: 35 at most</field>
        <field name="family">meal</field>
        <field name="meal_period">dinner</field>
        <field name="amount">35</field>
    </record>
    <record id="demo_policy_daily_meals" model="expense.scan.policy.rule"
            context="{'expense_scan_no_recheck': True}">
        <field name="policy_id" ref="demo_policy"/>
        <field name="sequence">5</field>
        <field name="name">Meals of the day: 55 in total (a more expensive meal is accepted within this limit)</field>
        <field name="family">meal</field>
        <field name="rule_type">daily_max</field>
        <field name="meal_period">day</field>
        <field name="amount">55</field>
    </record>
    <record id="demo_policy_hotel" model="expense.scan.policy.rule"
            context="{'expense_scan_no_recheck': True}">
        <field name="policy_id" ref="demo_policy"/>
        <field name="sequence">6</field>
        <field name="name">Hotel: 110 a night, 140 in large cities</field>
        <field name="family">lodging</field>
        <field name="amount">110</field>
        <field name="per_night" eval="True"/>
        <field name="extra_amount">30</field>
        <field name="extra_cities">Paris, Lyon, Marseille, Nice, Bordeaux</field>
    </record>

    <function model="expense.scan.policy" name="_expense_scan_recheck_all"/>

</odoo>

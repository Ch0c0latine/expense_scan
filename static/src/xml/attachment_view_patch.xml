<templates xml:space="preserve">

    <!-- "Retouch" button under the preview image of an expense. Placed
         outside the image container: Odoo gives that one a negative z-index,
         which would block the click. -->
    <t t-inherit="mail.AttachmentView" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Attachment-imgContainer')]" position="after">
            <button t-if="this.expenseScanCanRetouch" type="button"
                    class="btn btn-sm btn-light o_expense_scan_retouch_control"
                    t-on-click="this.onExpenseScanRetouch">
                <i class="oi me-1" data-icon="crop" role="img" aria-hidden="true"/>Retouch
            </button>
        </xpath>
    </t>

</templates>

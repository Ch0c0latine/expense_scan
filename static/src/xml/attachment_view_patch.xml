<templates xml:space="preserve">

    <!-- Bouton « Retouche » sous l'image du volet d'aperçu, pour une
         dépense. Hors du conteneur de l'image : Odoo le place derrière le
         volet (z-index négatif), où aucun clic ne l'atteindrait. -->
    <t t-inherit="mail.AttachmentView" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Attachment-imgContainer')]" position="after">
            <button t-if="expenseScanCanRetouch" type="button"
                    class="btn btn-sm btn-light o_expense_scan_retouch_control"
                    t-on-click="onExpenseScanRetouch">
                <i class="fa fa-crop me-1" role="img" aria-hidden="true"/>Retouche
            </button>
        </xpath>
    </t>

</templates>

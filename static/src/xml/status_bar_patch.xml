<templates xml:space="preserve">

    <!--
        On a small screen, Odoo shows only one button and puts the others in
        a "..." menu. This template shows `expenseScanMaxSlots` of them: four
        on an expense, one everywhere else (the original behaviour outside
        this module).

        The branch is rewritten entirely: Odoo's template uses a single slot
        name, while a list is needed here. The menu that groups the next
        buttons uses Odoo's markup.
    -->
    <t t-name="expense_scan.StatusBarButtonsWide"
       t-inherit="web.StatusBarButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='this.uiService.isSmall']" position="replace">
            <t t-if="this.uiService.isSmall">
                <t t-set="shownSlots"
                   t-value="this.visibleSlotNames.slice(0, this.expenseScanMaxSlots)"/>
                <t t-set="otherSlots"
                   t-value="this.visibleSlotNames.slice(this.expenseScanMaxSlots)"/>
                <t t-foreach="shownSlots" t-as="slot" t-key="slot">
                    <t t-call-slot="{{ slot }}"/>
                </t>
                <Dropdown t-if="otherSlots.length">
                    <button class="btn btn-secondary" title="More">
                        <i class="oi oi-fw oi-ellipsis-v"/>
                    </button>
                    <t t-set-slot="content">
                        <t t-foreach="otherSlots" t-as="slot" t-key="slot">
                            <DropdownItem class="'o-dropdown-item-unstyled-button'">
                                <t t-call-slot="{{ slot }}"/>
                            </DropdownItem>
                        </t>
                    </t>
                </Dropdown>
            </t>
        </xpath>
    </t>

</templates>

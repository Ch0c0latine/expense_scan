<templates xml:space="preserve">

    <!--
        Sur petit écran, Odoo n'affiche qu'un bouton et place les autres dans
        un menu « … ». Ce gabarit en affiche `expenseScanMaxSlots` : trois sur
        une dépense, un partout ailleurs (comportement d'origine hors de ce
        module).

        La branche est réécrite entièrement : le gabarit d'Odoo utilise un
        seul nom de slot, alors qu'il faut ici une liste. Le menu qui
        regroupe les boutons suivants reprend le balisage d'Odoo.
    -->
    <t t-name="expense_scan.StatusBarButtonsWide"
       t-inherit="web.StatusBarButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='env.isSmall']" position="replace">
            <t t-if="env.isSmall">
                <t t-set="shownSlots"
                   t-value="visibleSlotNames.slice(0, expenseScanMaxSlots)"/>
                <t t-set="otherSlots"
                   t-value="visibleSlotNames.slice(expenseScanMaxSlots)"/>
                <t t-foreach="shownSlots" t-as="slot" t-key="slot">
                    <t t-slot="{{ slot }}"/>
                </t>
                <Dropdown t-if="otherSlots.length">
                    <button class="btn btn-secondary" title="More">
                        <i class="oi oi-fw oi-ellipsis-v"/>
                    </button>
                    <t t-set-slot="content">
                        <t t-foreach="otherSlots" t-as="slot" t-key="slot">
                            <DropdownItem class="'o-dropdown-item-unstyled-button'">
                                <t t-slot="{{ slot }}"/>
                            </DropdownItem>
                        </t>
                    </t>
                </Dropdown>
            </t>
        </xpath>
    </t>

</templates>

<templates xml:space="preserve">

    <!--
        Odoo déclare le champ fichier avec accept="*". Sur téléphone, le
        sélecteur générique propose « Fichiers » et masque l'appareil photo.
        Avec une restriction aux images (et aux PDF), iOS et Android ouvrent
        directement la feuille « Appareil photo / Photothèque / Fichiers » :
        le scan se fait en un seul appui.

        Sur petit écran, accept se limite aux images : avec un type non-image
        (PDF), Android ouvre son sélecteur de fichiers générique, sans
        l'onglet Photos, et la galerie n'est plus proposée. Sur ordinateur,
        le PDF reste accepté, car c'est là que le justificatif reçu par mail
        est déposé.
    -->
    <t t-name="expense_scan.ListViewAccept" t-inherit="hr_expense.ListView" t-inherit-mode="extension">
        <xpath expr="//input[@name='ufile']" position="attributes">
            <attribute name="t-att-accept">env.isSmall ? 'image/*' : 'image/*,application/pdf'</attribute>
        </xpath>
    </t>

    <t t-name="expense_scan.KanbanViewAccept" t-inherit="hr_expense.KanbanView" t-inherit-mode="extension">
        <xpath expr="//input[@name='ufile']" position="attributes">
            <attribute name="t-att-accept">env.isSmall ? 'image/*' : 'image/*,application/pdf'</attribute>
        </xpath>
    </t>

</templates>

<templates xml:space="preserve">

    <!--
        Odoo declares the file input with accept="*". On a phone, the generic
        picker offers "Files" and hides the camera. Restricted to images (and
        PDFs), iOS and Android open the "Camera / Photo Library / Files" sheet
        directly: the scan takes a single tap.

        On a small screen, accept is limited to images: with a non-image type
        (PDF), Android opens its generic file picker, without the Photos tab,
        and the gallery is no longer offered. On a computer, PDF is still
        accepted, since that is where a receipt received by e-mail gets
        uploaded.
    -->
    <t t-name="expense_scan.ListViewAccept" t-inherit="hr_expense.ListView" t-inherit-mode="extension">
        <xpath expr="//input[@name='ufile']" position="attributes">
            <attribute name="t-att-accept">env.isSmall ? 'image/*' : 'image/*,application/pdf'</attribute>
        </xpath>
    </t>

    <t t-name="expense_scan.KanbanViewAccept" t-inherit="hr_expense.KanbanView" t-inherit-mode="extension">
        <xpath expr="//input[@name='ufile']" position="attributes">
            <attribute name="t-att-accept">env.isSmall ? 'image/*' : 'image/*,application/pdf'</attribute>
        </xpath>
    </t>

</templates>

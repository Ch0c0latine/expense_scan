<templates xml:space="preserve">

    <!--
        On a scanned expense, the discussion thread is of little use: the form
        is there to review a few fields. Its three buttons are hidden and its
        history is folded.

        A class on the <form> tag does not work: Odoo's form compiler does not
        pass it on to the DOM (it only keeps a component property from it),
        and the chatter is compiled as a sibling of the sheet, out of reach of
        a class set inside it.

        The patch therefore targets the chatter, which receives the model it
        belongs to. Other models are not changed.
    -->
    <t t-name="expense_scan.ChatterSlim" t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Chatter-sendMessage')]" position="attributes">
            <attribute name="t-if">this.threadModel() !== 'hr.expense'</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="attributes">
            <attribute name="t-if">this.threadModel() !== 'hr.expense'</attribute>
        </xpath>
        <!-- This button already has a condition: it is extended, not
             replaced. -->
        <xpath expr="//button[hasclass('o-mail-Chatter-activity')]" position="attributes">
            <attribute name="t-if">this.webChatterProps.has_activities and this.threadModel() !== 'hr.expense'</attribute>
        </xpath>
        <!-- The history stays folded, one click away. It is rendered by a
             component in a `t-else`, which takes no condition: the container
             gets a class, and the stylesheet hides the history. -->
        <xpath expr="//span[hasclass('o-mail-Chatter-topbarGrow')]" position="before">
            <button t-if="this.threadModel() === 'hr.expense'"
                    class="o-mail-Chatter-expenseScanHistory btn btn-link text-action text-nowrap px-1 my-2"
                    
                    t-att-aria-expanded="this.state.expenseScanHistory ? 'true' : 'false'"
                    t-on-click="() => this.state.expenseScanHistory = !this.state.expenseScanHistory">
                <i class="oi oi-fw" t-att-data-icon="this.state.expenseScanHistory ? 'arrow_drop_down' : 'arrow_right'"
                   aria-hidden="true"/>
                History
            </button>
        </xpath>
        <xpath expr="//div[hasclass('o-mail-Chatter-content')]" position="attributes">
            <attribute name="t-att-class">this.threadModel() === 'hr.expense' and !this.state.expenseScanHistory ? 'o_expense_scan_slim' : ''</attribute>
        </xpath>
    </t>

</templates>

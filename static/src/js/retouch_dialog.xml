<templates xml:space="preserve">

    <t t-name="expense_scan.RetouchDialog">
        <Dialog title="title" size="'md'" footer="false">
            <div class="o_expense_scan_retouch" t-ref="container">
                <div t-if="state.error" class="alert alert-danger py-1 px-2 small mb-2">
                    <t t-esc="state.error"/>
                </div>
                <div t-if="!state.loaded and !state.error" class="text-center text-muted py-5">
                    <i class="fa fa-circle-o-notch fa-spin fa-2x" role="img" aria-hidden="true"/>
                </div>
                <!-- Toujours dans le DOM : il doit exister au moment où
                     l'image se charge, pour être dimensionné aussitôt. -->
                <div class="text-center" t-att-class="{ 'd-none': !state.loaded }">
                    <canvas t-ref="canvas"
                            class="o_expense_scan_retouch_canvas"
                            t-att-class="{ 'o_expense_scan_retouch_dragging': state.dragging }"
                            t-on-pointerdown="onPointerDown"
                            t-on-pointermove="onPointerMove"
                            t-on-pointerup="onPointerUp"
                            t-on-pointercancel="onPointerUp"/>
                </div>

                <div t-if="state.loaded" class="mt-3">
                    <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                title="Tourner à gauche" t-on-click="() => this.turn(-1)">
                            <i class="fa fa-rotate-left" role="img" aria-label="Tourner à gauche"/>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                title="Tourner à droite" t-on-click="() => this.turn(1)">
                            <i class="fa fa-rotate-right" role="img" aria-label="Tourner à droite"/>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                title="Tout garder" t-on-click="() => this.resetCrop()">
                            <i class="fa fa-expand" role="img" aria-label="Tout garder"/>
                        </button>
                    </div>
                    <div class="d-flex align-items-center gap-2 px-2">
                        <i class="fa fa-repeat text-muted" role="img" aria-hidden="true"/>
                        <input type="range" class="form-range flex-grow-1"
                               t-att-min="-fineRange" t-att-max="fineRange" step="0.5"
                               t-att-value="state.fine" t-on-input="onFineInput"
                               aria-label="Rotation fine"/>
                        <span class="text-muted small o_expense_scan_retouch_angle"
                              t-esc="angleDegrees.toFixed(1) + '°'"/>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" class="btn btn-secondary" t-on-click="() => this.props.close()"
                            t-att-disabled="state.busy">
                        Annuler
                    </button>
                    <button type="button" class="btn btn-primary" t-on-click="onApply"
                            t-att-disabled="!state.loaded or state.busy">
                        <i t-if="state.busy" class="fa fa-circle-o-notch fa-spin me-1"
                           role="img" aria-hidden="true"/>
                        Appliquer et relancer l'analyse
                    </button>
                </div>
            </div>
        </Dialog>
    </t>

</templates>

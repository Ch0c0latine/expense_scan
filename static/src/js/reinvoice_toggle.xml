<templates xml:space="preserve">

    <t t-name="expense_scan.ReinvoiceToggle">
        <button type="button" class="btn btn-link p-0 border-0 o_expense_scan_reinvoice"
                t-att-class="{
                    'text-success': this.mode === 'project',
                    'text-warning': this.mode === 'todo',
                    'text-muted': this.mode === 'none',
                    'o_expense_scan_reinvoice_locked': this.locked and !this.selection.length,
                }"
                t-att-title="this.title"
                t-on-click.stop.prevent="this.onClick">
            <i t-if="this.mode === 'project'" class="oi oi-lg" data-icon="check_box" role="img" aria-label="Yes"/>
            <i t-elif="this.mode === 'todo'" class="oi oi-lg" data-icon="help" role="img" aria-label="To decide"/>
            <i t-else="" class="oi oi-lg" data-icon="indeterminate_check_box" role="img" aria-label="No"/>
        </button>
    </t>

    <t t-name="expense_scan.ReinvoiceChoice">
        <Dialog title.translate="Re-invoice the selection" size="'md'">
            <p>The selected expenses do not all have the same answer. Which one should they all take?</p>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="() => this.pick('project')">Yes</button>
                <button class="btn btn-secondary" t-on-click="() => this.pick('none')">No</button>
                <button class="btn btn-secondary" t-on-click="() => this.pick('todo')">To decide</button>
                <button class="btn btn-link" t-on-click="this.props.close">Cancel</button>
            </t>
        </Dialog>
    </t>

</templates>

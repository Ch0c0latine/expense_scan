<templates xml:space="preserve">

    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_control_panel_actions')]" position="inside">
            <div t-if="expenseMonthButtons.length" class="btn-group me-2 order-first o_expense_scan_months">
                <button t-foreach="expenseMonthButtons" t-as="button" t-key="button.id" type="button"
                        class="btn btn-secondary"
                        t-att-class="{ active: button.active }"
                        t-on-click="() => this.toggleExpenseMonth(button)">
                    <t t-out="button.label"/>
                </button>
            </div>
        </xpath>
    </t>

</templates>
